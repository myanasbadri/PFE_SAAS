@startuml Diagramme_Interface_Client_Backend_Part2
title Diagramme de composants — Interface client-serveur (2/2) : Couche serveur
skinparam backgroundColor #FFFFFF
skinparam shadowing true
skinparam dpi 200
skinparam defaultFontName "Segoe UI"
skinparam defaultFontSize 13
skinparam componentStyle rectangle
skinparam titleFontSize 18

skinparam component {
  BackgroundColor #F0F4FF
  BorderColor #3366CC
  BorderThickness 2
  FontColor #0A2540
}

skinparam package {
  BackgroundColor #F5F9FF
  BorderColor #2E75B6
  BorderThickness 2
  FontStyle bold
  RoundCorner 10
}

skinparam note {
  BackgroundColor #FFF9C4
  BorderColor #CC9900
}

skinparam arrow {
  Color #2C3E50
  FontColor #2E75B6
  FontSize 11
  Thickness 1.5
}

interface "API REST\nJSON / multipart\n(HTTPS)" as REST

package "Couche Serveur — Flask / Python 3.10" as SERVER #E8F5E9 {

  package "Décorateurs d'autorisation" as DECOS {
    component [@token_required] as DecTok #FFF9C4
    component [@org_required] as DecOrg #FFF9C4
    component [@org_admin_required] as DecAdmin #FFF9C4
    component [@check_plan_limit] as DecPlan #FFF9C4
  }

  package "Points de terminaison (85 endpoints)" as ENDPOINTS {
    component [/api/auth/**\n(login, register)] as EpAuth
    component [/api/invoices/**\n(CRUD, filtres)] as EpInv
    component [/api/extract-file\n(upload + extraction)] as EpExt #FFE0B2
    component [/api/advisor/chat\n(conseiller IA)] as EpAdv #FFE0B2
    component [/api/organizations/**\n(CRUD, membres)] as EpOrg
    component [/api/notifications/**\n(lecture, préférences)] as EpNotif
    component [/api/invoices/*/qrcode\n(partage QR)] as EpQR
    component [/api/ttn/**\n(El Fatoora)] as EpTTN
    component [/api/billing/**\n(Stripe)] as EpBill
    component [/api/tej/**\n(certificats)] as EpTej
  }

  package "Services métier (19 modules)" as SERVICES {
    component [auth_service] as SvcAuth
    component [extractor_core] as SvcExt #FFE0B2
    component [tax_validator] as SvcTax
    component [service_detector] as SvcDet
    component [org_service] as SvcOrg
    component [notification_service] as SvcNotif
    component [billing_service] as SvcBill
    component [signature_validator] as SvcSig
    component [xml_parser] as SvcXml
  }
}

package "Couche Données" as DATA #F3E5F5 {
  database "MongoDB 7\n(11 collections)" as Mongo
  database "Redis 7\n(cache + Celery)" as Redis
}

package "Services IA" as AIEXT #FFF3E0 {
  component [Claude Vision API\n(Anthropic)] as Claude #FFCC80
  component [Ollama local\n(qwen2.5:7b-instruct)] as Ollama #FFAB91
}

REST -down-> DECOS
DECOS -down-> ENDPOINTS

EpAuth --> SvcAuth
EpExt --> SvcExt
EpInv --> SvcExt
EpOrg --> SvcOrg
EpNotif --> SvcNotif
EpBill --> SvcBill

SERVICES -down-> Mongo
SERVICES -down-> Redis

SvcExt -right-> Claude : Vision API\n(pas d'OCR)
SvcExt -right-> Ollama : OCR + texte\n(fallback)

legend bottom right
  <b>Légende</b>
  |<back:#E8F5E9>       </back>| Couche Serveur (Flask) |
  |<back:#F3E5F5>       </back>| Couche Données |
  |<back:#FFE0B2>       </back>| Modules IA |
  |<back:#FFF9C4>       </back>| Décorateurs d'autorisation |
  |<back:#FFF3E0>       </back>| Services IA externes |
endlegend

@enduml
