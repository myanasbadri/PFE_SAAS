# ── Database ─────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=invoice_ai

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=your-secure-random-string-here

# ── Server ───────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false

# ── LLM (Groq — free 14,400 req/day) ────────────────────────────────
GROQ_API_KEY=gsk_your_groq_api_key
GROQ_MODEL=llama-3.3-70b-versatile

# ── Ollama (disabled in production — leave empty) ────────────────────
OLLAMA_URL=
OLLAMA_MODEL=

# ── Celery / Redis ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://default:password@host:port
CELERY_RESULT_BACKEND=redis://default:password@host:port

# ── CORS (comma-separated frontend URLs) ────────────────────────────
CORS_ORIGINS=https://your-frontend.up.railway.app

# ── Frontend URL (used in email links) ──────────────────────────────
APP_URL=https://your-frontend.up.railway.app

# ── MagicBell Notifications ─────────────────────────────────────────
MAGICBELL_API_KEY=
MAGICBELL_API_SECRET=

# ── Gmail SMTP ──────────────────────────────────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Stripe Billing ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
