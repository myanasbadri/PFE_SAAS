# ── Database ─────────────────────────────────────────────────────────
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/
DB_NAME=invoice_ai

# ── Auth ─────────────────────────────────────────────────────────────
JWT_SECRET=your-secure-random-string-here

# ── Google OAuth ─────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# ── Server ───────────────────────────────────────────────────────────
PORT=5000
FLASK_DEBUG=false

# ── LLM (Claude API — primary) ──────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key
CLAUDE_MODEL=claude-sonnet-4-20250514

# ── Ollama (fallback — leave empty to disable) ──────────────────────
OLLAMA_URL=
OLLAMA_MODEL=

# ── Celery / Redis ──────────────────────────────────────────────────
CELERY_BROKER_URL=redis://default:password@host:port
CELERY_RESULT_BACKEND=redis://default:password@host:port

# ── CORS (comma-separated frontend URLs) ────────────────────────────
CORS_ORIGINS=https://your-frontend.up.railway.app

# ── Frontend URL (used in email links) ──────────────────────────────
APP_URL=https://your-frontend.up.railway.app

# ── MagicBell Notifications ─────────────────────────────────────────
MAGICBELL_API_KEY=
MAGICBELL_API_SECRET=

# ── Gmail SMTP ──────────────────────────────────────────────────────
SMTP_EMAIL=
SMTP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Stripe Billing ──────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_ENTERPRISE=
